{
  "out": "screenshots/phase2/17-company-identities",
  "shots": [
    {
      "name": "01-marketplace-shelf",
      "steps": [
        {
          "go": "/reshoot?to=/marketplace"
        },
        {
          "eval": "localStorage.setItem('asc.theme','dark'); document.documentElement.removeAttribute('data-theme')"
        },
        {
          "wait": 1600
        },
        {
          "scroll": "#open-now"
        },
        {
          "wait": 600
        },
        {
          "eval": "(() => { const logos = document.querySelectorAll('.deal-card [data-kind]'); if (logos.length < 6) throw new Error('logos on cards: ' + logos.length); const kinds = new Set([...logos].map(l => l.getAttribute('data-kind'))); if (kinds.size < 3) throw new Error('only ' + kinds.size + ' kinds of logo on the shelf'); })()"
        }
      ]
    },
    {
      "name": "02-marketplace-shelf-row-two",
      "steps": [
        {
          "go": "/reshoot?to=/marketplace"
        },
        {
          "eval": "localStorage.setItem('asc.theme','dark'); document.documentElement.removeAttribute('data-theme')"
        },
        {
          "wait": 1600
        },
        {
          "eval": "(() => { const cards = document.querySelectorAll('.deal-card'); cards[Math.min(6, cards.length - 1)].scrollIntoView({ block: 'center', behavior: 'instant' }); })()"
        },
        {
          "wait": 600
        }
      ]
    },
    {
      "name": "03-radar-board",
