{
  "out": "screenshots/phase2/01-relationship-gate",
  "shots": [
    {
      "name": "01-questionnaire-empty",
      "steps": [{ "go": "/reshoot?as=new&to=/wizard?step=1" }]
    },
    {
      "name": "02-questionnaire-answered",
      "steps": [
        { "go": "/reshoot?as=new&to=/wizard?step=1" },
        { "eval": "(() => { const pick = (label) => [...document.querySelectorAll('[role=radio] b')].find(b => b.textContent.trim() === label).closest('[role=radio]').click(); pick('Net worth over $1,000,000'); pick('5 or more'); pick('Over 10 years'); pick('I evaluate private deals myself'); document.querySelectorAll('.wiz-panel.on input[type=checkbox]').forEach(c => c.click()); })()" },
        { "wait": 300 },
        { "scroll": ".wiz-panel.on .card:nth-of-type(3)" }
      ],
      "scroll": ".wiz-panel.on .card:nth-of-type(3)"
    },
    {
      "name": "03-cooling-off",
      "steps": [
        { "go": "/reshoot?as=new&to=/dashboard" },
        { "post": "/api/accreditation/questionnaire", "body": { "basis": "net_worth", "privateDeals": "many", "yearsInvesting": "over_10", "evaluates": "self", "acknowledgements": { "loss": true, "illiquid": true, "no_advice": true } } },
        { "go": "/wizard?step=1" }
      ]
    },
    {
      "name": "04-marketplace-cooling-off",
      "steps": [
        { "go": "/reshoot?as=new&to=/dashboard" },
        { "post": "/api/accreditation/questionnaire", "body": { "basis": "income", "privateDeals": "some", "yearsInvesting": "3_to_10", "evaluates": "adviser", "acknowledgements": { "loss": true, "illiquid": true, "no_advice": true } } },
        { "get": "/api/deals", "expect": 200 },
        { "get": "/api/deals/calder", "expect": 403 },
        { "get": "/api/deals/no-such-deal", "expect": 403 },
        { "post": "/api/accreditation/questionnaire", "expect": 400, "body": { "basis": "none", "privateDeals": "none", "yearsInvesting": "under_3", "evaluates": "learning", "acknowledgements": { "loss": true, "illiquid": true, "no_advice": true } } },
        { "go": "/marketplace" }
      ]
    },
    {
      "name": "05-deal-link-before-questionnaire",
      "steps": [
        { "go": "/reshoot?as=new&to=/deals/calder" },
        { "eval": "(() => { if (document.body.innerText.includes('Calder')) throw new Error('deal name leaked on the locked page'); if (document.title.includes('Calder')) throw new Error('deal name leaked in the title'); })()" }
      ]
    },
    {
      "name": "06-under-review",
      "steps": [
        { "go": "/reshoot?as=new&to=/dashboard" },
        { "post": "/api/accreditation/questionnaire", "body": { "basis": "net_worth", "privateDeals": "none", "yearsInvesting": "under_3", "evaluates": "learning", "acknowledgements": { "loss": true, "illiquid": true, "no_advice": true } } },
        { "go": "/wizard?step=1" }
      ]
    },
    {
      "name": "07-seeded-member-eligible",
      "steps": [
        { "go": "/reshoot?to=/marketplace" },
        { "get": "/api/deals/calder", "expect": 200 },
        { "eval": "(() => { if (!document.body.innerText.includes('Calder')) throw new Error('eligible member does not see the shelf'); })()" }
      ]
    }
  ]
}
