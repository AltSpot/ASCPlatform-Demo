    {
      "name": "01-rail-dashboard-ember",
      "steps": [
        {
          "go": "/reshoot?to=/dashboard"
        },
        {
          "eval": "localStorage.setItem('asc.theme','dark'); document.documentElement.removeAttribute('data-theme')"
        },
        {
          "wait": 1800
        },
        {
          "eval": "(() => { const nav = document.querySelector('nav[aria-label=\"Investor portal\"]'); const a = nav.querySelector('[aria-current=\"page\"]'); if (!a) throw new Error('no lit row'); const slot = a.querySelector('span'); const cs = getComputedStyle(slot); if (cs.backgroundColor !== 'rgba(0, 0, 0, 0)' && cs.backgroundColor !== 'transparent') throw new Error('the icon still sits on a tile: ' + cs.backgroundColor); if (getComputedStyle(a).borderRadius === '100px') throw new Error('the row is still a pill'); })()"
        }
      ]
    },
