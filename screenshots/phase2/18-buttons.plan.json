{
  "out": "screenshots/phase2/18-buttons",
  "shots": [
    {
      "name": "01-marketplace-shelf",
      "steps": [
        {
          "go": "/reshoot?to=/marketplace"
        },
        {
          "eval": "localStorage.setItem('asc.theme','dark'); document.documentElement.removeAttribute('data-theme')"
        },
        {
          "wait": 1600
        },
        {
          "scroll": "#open-now"
        },
        {
          "wait": 600
        },
        {
          "eval": "(() => { const n = [...document.querySelectorAll('.btn-gold')].filter(b => { const r = b.getBoundingClientRect(); return r.width > 0 && getComputedStyle(b).visibility !== 'hidden' && r.left < innerWidth && r.right > 0; }).length; if (n > 0) throw new Error('gold buttons on screen: ' + n); })()"
        },
        {
          "eval": "(() => { if (document.querySelectorAll('.deal-card .btn-orb').length < 6) throw new Error('card CTAs are not the orb style'); })()"
        }
      ]
    },
    {
      "name": "02-radar-board",
      "steps": [
        {
          "go": "/reshoot?to=/marketplace%3Fview%3Dradar"
