        },
        {
          "wait": 1800
        },
        {
          "eval": "(() => { const b = [...document.querySelectorAll('button[aria-pressed]')].find(x => x.textContent.trim() === 'Featured'); b.scrollIntoView({ block: 'start', behavior: 'instant' }); })()"
        },
        {
          "wait": 700
        }
      ]
    },
