# ============================================================
#  ASCPlatform — environment template
#
#  Copy to .env and fill in. .env is gitignored and is the only file
#  that ever holds a real credential; this template holds none.
#
#    cp .env.example .env
#
#  The defaults below are the demo defaults. Every one of them is safe
#  to run locally as written, except the deploy credentials at the
#  bottom, which are only needed by `npm run deploy*`.
# ============================================================

# ---------------- the application ----------------

# Prisma datasource. SQLite today, resolved relative to
# prisma/schema.prisma. Postgres later: swap the provider in
# prisma/schema.prisma and the adapter in lib/db.ts, then point this at
# the connection string. Read by lib/db.ts, prisma.config.ts, prisma/seed.ts.
DATABASE_URL="file:./ascplatform.db"

# Demo mode. Anything other than the exact string "false" means ON.
#
# ON:  any email + password signs in, an unknown email mints a new
#      investor, and accreditation, KYC/AML/OFAC, Plaid, ACH and e-sign
#      are all simulated. All money is fake.
# OFF: the real adapters in lib/integrations/ are required and the
#      simulated paths refuse.
#
# Read by lib/config.ts. Never point a demo-mode build at real data.
ASC_DEMO_MODE="true"

# Ephemeral demo. Anything other than "false" means ON.
# Demo accounts are swept after ASC_DEMO_TTL_HOURS, and each visitor sees
# deal allocation reduced only by their own commitments, so a link handed
# to twenty prospects never looks picked over. Read by lib/config.ts.
ASC_EPHEMERAL="true"

# How long a demo account survives after its last session was issued.
# Read by lib/config.ts. Ignored when ASC_EPHEMERAL is "false".
ASC_DEMO_TTL_HOURS="6"

# Port for `npm run serve` and `npm start`. 4000, not 3000 (in use by
# another project) and not a port below 1024 (those need root on macOS,
# which breaks unattended start). Read by scripts/dev-server.mjs,
# scripts/supervisor.mjs and the start scripts in package.json.
PORT="4000"

# ---------------- deploy tooling (optional) ----------------
# Only scripts/render.mjs reads these, for `npm run deploy`,
# `deploy:status`, `deploy:logs`, `deploy:env` and `deploy:wake`.
# The application never reads them. Auto-deploy on push to main already
# works without them; these exist to watch a deploy from the terminal.

# Account-scoped Render API key. A REAL SECRET. Leave empty unless you
# are deploying. Create one at
# https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=""

# The Render service this repo deploys to. An identifier, not a secret.
RENDER_SERVICE_ID=""
