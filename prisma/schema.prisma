// ============================================================
//  ASCPlatform — data model
//
//  Design notes (this is a demo, but the schema is production-shaped):
//   * SQLite is the demo store. Every model below maps 1:1 onto a
//     Postgres schema — swap the datasource provider and the adapter,
//     nothing in the application layer changes.
//   * SQLite supports neither Prisma enums nor the Json scalar, so
//     status columns are String (union types live in lib/domain.ts) and
//     structured editorial blobs are String holding JSON. The repository
//     layer in lib/repositories/ is the only place that parses them.
//   * No real PII is ever stored. Taxpayer IDs keep last-4 only, beside a
//     surrogate token standing in for the tokenization vault that a
//     production build would call.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------- identity ----------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Rule 506(b): when AltSpot approved this member's questionnaire, which
  /// is when the pre-existing relationship was established. Offerings open
  /// after the cooling-off period, and a member may subscribe only to deals
  /// that opened after this date. Null until approved.
  relationshipEstablishedAt DateTime?
  /// The referral link this member signed up through, if any: a code from
  /// ReferralCode, kept as text so it survives the code being retired.
  /// REPORTING ONLY. Nothing in fee, carry or eligibility logic may read it;
  /// tests/referral.test.ts fails if one does.
  referralCode String?
  /// partner | member, copied at sign-up for the same reporting.
  referralKind String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  accreditation Accreditation?
  kyc           KycRecord?
  vault         VaultInfo?
  wizard        WizardState?
  profiles      InvestmentProfile[]
  bankAccounts  BankAccount[]
  subscriptions Subscription[]
  externalPositions ExternalPosition[]
  documents     Document[]
  auditLogs     AuditLog[]
  radarInterest RadarInterest[]
  watchlist     WatchlistItem[]
  inviteCode    ReferralCode?

  @@map("users")
}

/// Opaque, server-issued session tokens held in an httpOnly cookie.
/// Swapping in a real IdP means replacing lib/auth.ts only.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------- verification / onboarding ----------------

/// Rule 506(b) accreditation and sophistication questionnaire: a
/// self-certification, evaluated by AltSpot. The answers and their
/// timestamps are the record supporting a reasonable belief.
/// status: not_started | under_review | approved | declined
model Accreditation {
  id          String    @id @default(cuid())
  userId      String    @unique
  status      String    @default("not_started")
  method      String?
  /// The accredited-investor standard the member certified (lib/relationship.ts).
  basis       String?
  /// The full questionnaire as submitted, JSON.
  answersJson String?
  /// The evaluation's plain-language reason, as shown to the member.
  reason      String?
  submittedAt DateTime?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accreditations")
}

/// KYC / AML / OFAC screening record.
/// status: not_started | pending | cleared | rejected
model KycRecord {
  id             String    @id @default(cuid())
  userId         String    @unique
  status         String    @default("not_started")
  idUploaded     Boolean   @default(false)
  idFileName     String?
  selfieCaptured Boolean   @default(false)
  submittedAt    DateTime?
  clearedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_records")
}

/// "The Vault" — W-9 information captured once; pre-fills every document.
/// The taxpayer ID is never stored in full: last 4 + surrogate token only.
model VaultInfo {
  id       String  @id @default(cuid())
  userId   String  @unique
  first    String?
  last     String?
  taxClass String?
  street   String?
  city     String?
  state    String?
  zip      String?
  tinLast4 String?
  tinToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vault_info")
}

/// Progress through the 5-step setup wizard. Accreditation, W-9 and KYC
/// completion are derived from their own records; these two are not.
model WizardState {
  id          String    @id @default(cuid())
  userId      String    @unique
  profileDone Boolean   @default(false)
  bankDone    Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wizard_state")
}

// ---------------- investor entities ----------------

/// The entity an investment is held under: Personal, Entity, IRA / 401(k).
model InvestmentProfile {
  id        String   @id @default(cuid())
  userId    String
  type      String
  name      String
  taxClass  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([userId])
  @@map("investment_profiles")
}

/// Linked funding source. Production links through Plaid; only the
/// institution and a 4-digit mask are ever persisted.
model BankAccount {
  id          String   @id @default(cuid())
  userId      String
  institution String
  mask        String
  type        String   @default("Checking")
  isDefault   Boolean  @default(true)
  linkedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bank_accounts")
}

// ---------------- marketplace ----------------

/// A deal on the shelf. The JSON-shaped columns hold editorial content
/// (thesis, deck slides, SpotBot Q&A) that a CMS would own in production.
model Deal {
  id                  String @id
  name                String
  entity              String
  tag                 String
  kind                String
  sector              String
  stage               String
  /// Asset class key from lib/taxonomy.ts. Groups the portfolio page.
  assetClass          String @default("venture")
  /// Industry key from lib/taxonomy.ts. Null for a multi-deal fund,
  /// which spans industries by construction.
  industry            String?
  art                 String
  blurb               String
  risks               String
  minInvestment       Int
  allocationTotal     Int
  allocationRemaining Int
  targetClose         String
  /// When the offering opened to members. Rule 506(b): a member may subscribe
  /// only to deals launched after their relationship was established
  /// (User.relationshipEstablishedAt); earlier deals are shown view-only.
  launchedAt          DateTime @default(now())
  /// The raise the SPV must reach to close. Subscriptions sit in escrow
  /// until it is met; if it is not met by the closing date, escrow refunds.
  /// The funding-progress bar measures raised against this, not against
  /// the allocation, which is only the "up to" cap.
  minimumToClose      Int    @default(0)
  /// 'altspot' or 'partner'. Who leads the deal. AltSpot organizes and
  /// advises every SPV either way.
  leadType            String @default("altspot")
  /// Most members this SPV may admit. 100 by default; up to 250 only for
  /// a qualifying venture capital fund of $12M or less. A setting per SPV.
  investorCap         Int    @default(100)
  altspotCommitted    Int
  committedNote       String
  status              String @default("open")
  sortOrder           Int    @default(0)

  /// Company mark, served from /public. Null falls back to the gradient.
  logoUrl String?
  /// A walkthrough, if one has been recorded. The deal page leads with
  /// it when present and falls back to the artwork when it is null, so
  /// a deal without a film is not a deal with a hole in its hero.
  videoUrl String?

  /// One-line pull quote used at the top of the deal page.
  headline String?

  /// Two or three sentences under the media slot. Not the blurb.
  summary String?

  /// Per-share price for the round. Null hides the row.
  pricePerShare String?

  // JSON-encoded — see the note at the top of this file.
  thesisJson  String
  feesJson    String
  mediaJson   String
  /// Series from the financial data room, as DealChart[]. Empty for a
  /// deal with no company data behind it, which is every secondary.
  chartsJson          String?
  docsJson    String
  spotbotJson String
  deckJson    String
  /// Headline figures shown as the stat band on the deal page.
  metricsJson String @default("[]")
  /// Economic terms: security, valuation, round size, price per share.
  termsJson   String @default("[]")
  /// Preferred terms: liquidation preference, pro-rata, warrants, rights.
  preferredTermsJson String @default("[]")
  /// Short bullets. Why we like it, one to three lines each.
  whatWeLikeJson     String @default("[]")
  /// Comparables and illustrative return scenarios.
  outcomesJson       String @default("{}")
  /// The standard revenue-company indicator set. See lib/indicators.ts.
  indicatorsJson     String @default("{}")
  /// Priced-round history: valuation and price per share, round by round.
  roundsJson         String @default("[]")
  /// The other firms on the round, as Backing[] from lib/backers.ts.
  /// Who led, who is co-investing. Empty when AltSpot is alone.
  backingJson        String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  documents     Document[]
  watchers      WatchlistItem[]

  @@map("deals")
}

/// A deal one investor has saved to their own watchlist.
///
/// Private to that investor and inert: saving a deal reserves nothing,
/// signals nothing to the issuer and is not an indication of interest.
/// One row per investor per deal, which is what makes the toggle
/// idempotent.
///
/// "Watchlist" is this feature and only this feature. AltSpot Radar is
/// a different thing and is never called one.
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  dealId    String
  /// The investor's own order for the list, 1-indexed. Zero means they
  /// have never reordered, and an unranked row falls back to newest
  /// first, so a list nobody has dragged still reads sensibly.
  rank      Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([userId, dealId])
  @@index([userId])
  @@map("watchlist_items")
}

// ---------------- the subscription state machine ----------------

/// started -> docs_signed -> funded -> accepted -> closed
/// exits:   expired (10-day funding window lapsed) | refunded | cut_back
/// Cash returned to an investor from a position. Production shape:
/// distributions are events with a date and a character, not a running
/// total, because return of capital and gain are taxed differently and
/// a statement has to be able to say which was which.
///
/// Empty today. Nothing on the platform has exited.
model Distribution {
  id             String   @id @default(cuid())
  subscriptionId String
  /// Integer dollars, like every other amount on the platform.
  amount         Int
  paidAt         DateTime
  /// "return_of_capital" | "gain"
  kind           String
  note           String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("distributions")
}

/// A holding the member has somewhere else.
///
/// AltSpot is trying to be the place a member reads their whole private
/// book, not only the part they bought here. A portfolio page that
/// silently omits two thirds of someone's private allocation is a page
/// they will check once and then go back to a spreadsheet.
///
/// SELF-REPORTED, AND NEVER LAUNDERED INTO AN ALTSPOT FIGURE. Every
/// value on this record is whatever the member typed. AltSpot has no
/// administrator behind it, no mark it can stand behind and no way to
/// verify any of it. Anything that totals these rows alongside AltSpot
/// positions has to say which is which.
model ExternalPosition {
  id     String @id @default(cuid())
  userId String

  /// The company or fund. Free text: this is not an AltSpot deal.
  name String
  /// Where it is actually held, e.g. "AngelList", "Carta", "Direct".
  custodian String?
  /// Taxonomy, so an external holding lands in the same breakdowns.
  assetClass String
  industry   String?

  /// Integer dollars, like every other amount on the platform.
  invested  Int
  /// The member's own latest mark on what is still held.
  fairValue Int @default(0)
  /// Cash they have had back.
  realized  Int @default(0)

  /// When the money went in. Drives vintage and the IRR.
  investedAt DateTime
  /// The date the member's fair value is as of.
  markedAt   DateTime?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("external_positions")
}

/// A reported mark on one position, at one date.
///
/// `Subscription.currentValue` is the latest of these, denormalised so
/// every list read does not have to join. This table is the history,
/// and it is what makes a portfolio value curve real rather than
/// interpolated: private marks arrive per reporting period, they do not
/// move between periods, and a chart that pretends otherwise is drawing
/// a line nobody reported.
model PositionMark {
  id             String   @id @default(cuid())
  subscriptionId String
  /// The reporting date this mark is as of.
  asOf           DateTime
  /// Integer dollars, like every other amount on the platform.
  value          Int
  /// Where it came from: "409a", "round", "vehicle", "exit".
  basis          String   @default("vehicle")
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, asOf])
  @@index([subscriptionId])
  @@map("position_marks")
}

model Subscription {
  id        String  @id @default(cuid())
  userId    String
  dealId    String
  profileId String?
  amount    Int

  state String @default("started")

  /// Per-section confirmations captured during document review.
  answersJson String @default("{}")

  signature       String?
  signedAt        DateTime?
  fundingDeadline DateTime?
  fundedAt        DateTime?
  fundingMethod   String?
  acceptedAt      DateTime?
  closedAt        DateTime?

  /// Latest reported mark. Null until the position is accepted.
  currentValue Int?

  /// When this position exited and its proceeds were distributed. Null
  /// while held. `state` cannot carry this: `closed` is the healthy end
  /// of the subscription lifecycle, meaning the deal closed and the
  /// investor is in it, not that the investment is over.
  realizedAt DateTime?

  /// True for demo-seeded positions, so a fresh login feels lived-in.
  seeded Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal      Deal               @relation(fields: [dealId], references: [id])
  profile   InvestmentProfile? @relation(fields: [profileId], references: [id])
  distributions Distribution[]
  marks     PositionMark[]
  documents Document[]

  @@index([userId])
  @@index([dealId])
  @@index([state])
  @@map("subscriptions")
}

// ---------------- documents ----------------

/// type: agreement | tax | verification | statement
model Document {
  id             String   @id @default(cuid())
  userId         String
  dealId         String?
  subscriptionId String?
  name           String
  type           String   @default("agreement")
  note           String?
  /// Rendered body, stored so Docs can re-open exactly what was signed.
  bodyHtml       String?
  /// Content hashes of every instrument in the binder at execution.
  /// A signed record must stay reproducible even after counsel reissues
  /// a document, so the version is pinned rather than looked up later.
  binderVersion  String?
  savedAt        DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [dealId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("documents")
}

// ---------------- audit ----------------

/// Append-only. Every transition that would need books-and-records
/// treatment in production is written here.
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  actor        String   @default("investor")
  action       String
  entity       String?
  entityId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------- AltSpot Radar ----------------

/// A member telling AltSpot which private company they want the
/// community to buy into next, and how much they would put behind it.
///
/// This is demand signal, NOT a commitment: no allocation moves, no
/// document is generated, no money is ever collected against it. The
/// amount is integer dollars, same as every other money column.
///
/// One row per member per company. Re-indicating replaces the amount
/// rather than double-counting, which is what the unique index buys.
model RadarInterest {
  id          String   @id @default(cuid())
  userId      String
  companySlug String
  amount      Int
  /// The member's own priority order for Your Radar, 1-indexed.
  /// Zero means unranked, and an unranked row falls back to demand
  /// order, so a member who never drags anything still sees a sensible
  /// board. This is a display preference, not a claim about the deal.
  rank        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companySlug])
  @@index([companySlug])
  @@map("radar_interests")
}

// ---------------- referrals ----------------

/// A referral link: /r/<code>. Partner codes are issued to syndicate
/// partners; a member code is created the first time a member opens their
/// invite link. Every link lands on the same sign-up and the same 506(b)
/// relationship gate, never on a deal.
/// kind: partner | member
model ReferralCode {
  code        String   @id
  kind        String
  /// Who the link belongs to, shown only in reporting. For a partner, the
  /// firm name; for a member, their name at the time the code was made.
  label       String
  ownerUserId String?  @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

// ---------------- SPV admissions ----------------

/// A member waiting for a spot in an SPV that has reached its investor
/// cap (Deal.investorCap). Joining reserves nothing and moves no money; if
/// a spot opens before admissions close, AltSpot tells members in the order
/// they joined. One row per member per deal.
model SpvWaitlistEntry {
  id        String   @id @default(cuid())
  userId    String
  dealId    String
  /// What the member would put in, if a spot opens. Integer dollars.
  amount    Int?
  createdAt DateTime @default(now())

  @@unique([userId, dealId])
  @@index([dealId])
  @@map("spv_waitlist")
}
