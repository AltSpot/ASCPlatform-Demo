# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env holds real credentials (see .env.example) and is never
# committed; the template is.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client. Build output, never committed: `npm install`
# regenerates it through the postinstall hook, and `npm run db:generate`
# rebuilds it on demand after a schema change.
/lib/generated

# local demo database (recreate with `npm run db:reset`)
*.db
*.db-journal
*.db-wal
*.db-shm

# dev-server supervisor pid + logs
/.run

# Agent skill sets installed by `prisma init` for editors we don't use.
# The .claude/ copy is kept, since this project is built with Claude Code.
/.windsurf
/.agents
